# delta — Nord light (nord-term points current.gitconfig here)
[delta]
    light = true
    syntax-theme = Coldark-Cold
    line-numbers-zero-style = "#9AA5B8"
    line-numbers-minus-style = "#BF616A"
    line-numbers-plus-style = "#6E8F53"
    file-style = "#5E81AC bold"
    hunk-header-style = "file line-number syntax"
    hunk-header-decoration-style = "#9AA5B8 box"
